#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define HAL 0
#define SYM 1
#define FUN 2
#define NAV 3
#define QWE 4

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			// ----------------------------------------------------------------------------------------------------------------------------------
			// |  TAB  |  W  |  L   |  R   |  B   |  Z   |                                        |  ;   |  Q    |  U    |  D    |   J   |   \  |
			// |  ESC  |  S  |  H   |  N   |  T   |  ,   |                                        |  .   |  A    |  E    |  O    |   I   |   '  |
			// | SHIFT |  F  |  M   |  V   |  C   |  /   |                                        |  G   |  P    |  X    |  K    |   Y   | CTRL |
			//               | LCTL | LWIN |BKSP  | SPC  | LBKT  |  CAPS   |  | L SHIFT | L SHIFT | TAB  | BSPC  | R-ALT | R-ALT |
			//                                           | MO 3  |  MO 2   |  |   RET   |  SPACE  |
			label = "Def";
			bindings = <
				&kp TAB       &kp W  &kp L      &kp R     &kp B     &kp Z                                                      &kp SEMI &kp Q     &kp U      &kp D     &kp J     &kp BSLH
				&mt LCTRL ESC &kp S  &kp H      &kp N     &kp T     &kp COMMA                                                  &kp DOT  &kp A     &kp E      &kp O     &kp I     &mt RCTL SQT
				&kp LSHFT     &kp F  &kp M      &kp V     &kp C     &kp FSLH                                                   &kp G    &kp P     &kp X      &kp K     &kp Y     &kp RSHIFT
							         &kp LALT   &kp LWIN  &kp BSPC  &kp SPACE  &kp LBKT  &kp CAPS         &kp FUN    &kp RBKT  &kp RET  &kp RALT  &kp RWIN   &kp K_APP
														     			 	   &mo NAV   &mo FUN          &kp TAB    &mo SYM   
			>;
		};

		sym_layer {
			// ----------------------------------------------------------------------------------------------------------------------------------
			// | ` | 1 | 2 | 3 | 4 | 5 |                  | 6 | 7 | 8 | 9 | 0 | = |
		    // | ~ | ! | @ | # | $ | % |                  | ^ | & | * | ( | ) | + |
			// | | | \ | : | ; | - | [ |                  | ] | _ | , | . | / | ? |
			//         | - | - | - | - | - | - |  | - | - | - | - | - | - |
			//                         | - | - |  | - | - |
			label = "Sym";
			bindings = <
				&kp GRAVE &kp N1     &kp N2      &kp N3      &kp N4      &kp N5                                            &kp N6     &kp N7     &kp N8      &kp N9     &kp N0      &kp EQUAL 
				&kp TILDE &kp EXCL   &kp AT      &kp HASH    &kp DLLR    &kp PRCNT                                         &kp CARET  &kp AMPS   &kp STAR    &kp LPAR   &kp RPAR    &kp PLUS 
				&kp PIPE  &kp BSLH   &kp COLON   &kp SEMI    &kp MINUS   &kp LBKT                                          &kp RBKT   &kp UNDER  &kp COMMA   &kp DOT    &kp FSLH    &kp QMARK 
						             &none       &none       &none       &none      &trans   &trans       &trans   &trans  &none      &none      &none       &none 
															                        &trans   &trans       &trans   &trans 
			>;
		};

		fun_layer {
			// ----------------------------------------------------------------------------------------------------------------------------------
			// | - | F9 | F10 | F11 | F12 | - |                  | - | -      | -     | -   | -   | - |
			// | - | F5 | F6  | F7  | F8  | - |                  | - | shift  | ctrl  | alt | gui | - |
			// | - | F1 | F2  | F3  | F4  | - |                  | - | -      | -     | -   | -   | - |
			//          |  -  |  -  |  -  | - | - | - |  | - | - | - | -      | -     | -   |
			//                                | - | - |  | - | - |
			label = "Fun";
			bindings = <
				&bootloader  &kp F9  &kp F10 &kp F11 &kp F12 &none                                          &to HAL  &none      &none      &none     &none      &bootloader 
				&none        &kp F5  &kp F6  &kp F7  &kp F8  &none                                          &to QWE  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI   &none 
				&none        &kp F1  &kp F2  &kp F3  &kp F4  &none                                          &none    &none      &none      &none     &none      &none 
				                     &none   &none   &none   &none   &trans   &trans       &trans   &trans  &none    &none      &none      &none 
				                                                     &trans   &trans       &trans   &trans
			>;
		};

		nav_layer {
			// ----------------------------------------------------------------------------------------------------------------------------------
			// | - | -    | -    | -     | -     | - |                  | PGUP  | HOME | UP   | END   | Vol Up | - |
			// | - | LGUI | LALT | LCTRL | LSHFT | - |                  | PGDN  | LEFT | DN   | RIGHT | Vol Dn | - |
			// | - | -    | -    | -     | -     | - |                  | Pause | Prev | p/p  | Next  | Mute   | - |
			//            | -    | -     | -     | - | - | - |  | - | - | -     | -    | -    | -     |
			//                                       | - | - |  | - | - |
			label = "Nav";
			bindings = <
				&none   &none    &none     &none      &none      &none                                          &kp PG_UP        &kp HOME    &kp UP   &kp END     &kp K_VOL_UP  &none 
				&none   &kp LGUI &kp LALT  &kp LCTRL  &kp LSHFT  &none                                          &kp PG_DN        &kp LEFT    &kp DOWN &kp RIGHT   &kp K_VOL_DN  &none 
				&none   &none    &none     &none      &none      &none                                          &kp PAUSE_BREAK  &kp K_PREV  &kp K_PP &kp K_NEXT  &kp K_MUTE    &none 
				                 &none     &none      &none      &none   &trans   &trans       &trans   &trans  &none            &none       &none    &none 
				                                                         &trans   &trans       &trans   &trans
			>;
		};

		qwerty_layer {
			// ----------------------------------------------------------------------------------------------------------------------------------
			// |  TAB  |  W  |  L   |  R   |  B   |  Z   |                                        |  ;   |  Q    |  U    |  D    |   J   |   \  |
			// |  ESC  |  S  |  H   |  N   |  T   |  ,   |                                        |  .   |  A    |  E    |  O    |   I   |   '  |
			// | SHIFT |  F  |  M   |  V   |  C   |  /   |                                        |  G   |  P    |  X    |  K    |   Y   | CTRL |
			//               | LCTL | LWIN |BKSP  | SPC  | LBKT  |  CAPS   |  | L SHIFT | L SHIFT | TAB  | BSPC  | R-ALT | R-ALT |
			//                                           | MO 3  |  MO 2   |  |   RET   |  SPACE  |
			label = "Def";
			bindings = <
				&kp TAB       &kp Q  &kp W      &kp E     &kp R     &kp T                                                      &kp Y    &kp U     &kp I      &kp O     &kp P     &kp BSLH
				&mt LCTRL ESC &kp A  &kp S      &kp D     &kp F     &kp G                                                      &kp H    &kp J     &kp K      &kp L     &kp SEMI  &mt RCTL SQT
				&kp LSHFT     &kp Z  &kp X      &kp C     &kp V     &kp B                                                      &kp N    &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHIFT
							         &kp LALT   &kp LWIN  &kp BSPC  &kp SPACE  &kp LBKT  &kp CAPS         &kp FUN    &kp RBKT  &kp RET  &kp RALT  &kp RWIN   &kp K_APP
														     			 	   &mo NAV   &mo FUN          &kp TAB    &mo SYM   
			>;
		};

	};
};